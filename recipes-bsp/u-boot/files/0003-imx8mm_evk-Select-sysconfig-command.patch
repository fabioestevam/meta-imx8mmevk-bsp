From 12136873c250ce95d30e2cc7409c6873e005d4c6 Mon Sep 17 00:00:00 2001
From: Fabio Estevam <festevam@gmail.com>
Date: Thu, 28 Aug 2025 16:42:08 -0300
Subject: [PATCH] imx8mm_evk: Select sysconfig command

The sysconfig command is needed when booting standard boot.

Signed-off-by: Fabio Estevam <festevam@gmail.com>
---
 configs/imx8mm_evk_defconfig | 1 +
 1 file changed, 1 insertion(+)

diff --git a/configs/imx8mm_evk_defconfig b/configs/imx8mm_evk_defconfig
index 3ae6c7585df6..1f360f88382b 100644
--- a/configs/imx8mm_evk_defconfig
+++ b/configs/imx8mm_evk_defconfig
@@ -120,3 +120,4 @@ CONFIG_SDP_LOADADDR=0x40400000
 CONFIG_USB_GADGET_DOWNLOAD=y
 CONFIG_SPL_USB_SDP_SUPPORT=y
 CONFIG_IMX_WATCHDOG=y
+CONFIG_CMD_SYSBOOT=y
-- 
2.34.1
